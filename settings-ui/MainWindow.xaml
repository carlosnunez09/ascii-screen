<Window x:Class="AsciiScreenSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ascii Screen" Width="560" Height="990" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen" ThemeMode="System">

    <Window.Resources>
        <!-- Windows 11 Settings style card: one rounded block, rows separated by thin lines -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="18,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="48"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Margin" Value="12,0,8,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,26" Grid.IsSharedSizeScope="True">

            <TextBlock Text="Ascii Screen" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,14"
                       Text="An ocean of letters for your desktop. Changes apply instantly."/>

            <!-- live preview: the same renderer the app uses -->
            <Border CornerRadius="10" BorderThickness="1" ClipToBounds="False"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid Height="220">
                    <Rectangle x:Name="PreviewRect" RadiusX="10" RadiusY="10" Fill="Black"
                               MouseMove="Preview_MouseMove" MouseLeave="Preview_MouseLeave" MouseLeftButtonDown="Preview_MouseDown"/>
                    <TextBlock Text="Live preview  -  move the mouse over it, click for a ripple" FontSize="11" Foreground="White" Opacity="0.55"
                               Margin="14,0,0,10" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Look -->
            <TextBlock Text="Look" Style="{StaticResource Heading}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Colour" Style="{StaticResource Title}"/>
                            <TextBlock Text="How the letters are inked" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <ComboBox x:Name="StyleBox" Grid.Column="1" Width="248" VerticalAlignment="Center" SelectionChanged="Changed">
                            <ComboBoxItem><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#8FB8E8" Margin="0,0,10,0"/><TextBlock Text="Original colours"/></StackPanel></ComboBoxItem>
                            <ComboBoxItem><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#33FF46" Margin="0,0,10,0"/><TextBlock Text="Green terminal"/></StackPanel></ComboBoxItem>
                            <ComboBoxItem><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FFB000" Margin="0,0,10,0"/><TextBlock Text="Amber terminal"/></StackPanel></ComboBoxItem>
                            <ComboBoxItem><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#EBEBEB" Margin="0,0,10,0"/><TextBlock Text="White"/></StackPanel></ComboBoxItem>
                            <ComboBoxItem><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#00E1FF" Margin="0,0,10,0"/><TextBlock Text="Cyan"/></StackPanel></ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Margin="0,0,10,0">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF5C5C" Offset="0"/>
                                                <GradientStop Color="#FFD84D" Offset="0.35"/>
                                                <GradientStop Color="#4DD6FF" Offset="0.7"/>
                                                <GradientStop Color="#B06BFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="Rainbow"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="18,0"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Letter size" Style="{StaticResource Title}"/>
                            <TextBlock Text="Smaller letters, finer detail" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="SizeSlider" Style="{StaticResource RowSlider}" Minimum="8" Maximum="24" TickFrequency="1" ValueChanged="Changed"/>
                            <TextBlock x:Name="SizeText" Style="{StaticResource Value}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ocean -->
            <TextBlock Text="Ocean" Style="{StaticResource Heading}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Swim speed" Style="{StaticResource Title}"/>
                            <TextBlock Text="Everything moves faster or slower" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="SpeedSlider" Style="{StaticResource RowSlider}" Minimum="25" Maximum="200" TickFrequency="5" ValueChanged="Changed"/>
                            <TextBlock x:Name="SpeedText" Style="{StaticResource Value}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="18,0"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fish" Style="{StaticResource Title}"/>
                            <TextBlock Text="How many in each school" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="FishSlider" Style="{StaticResource RowSlider}" Minimum="25" Maximum="200" TickFrequency="5" ValueChanged="Changed"/>
                            <TextBlock x:Name="FishText" Style="{StaticResource Value}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="18,0"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sharks" Style="{StaticResource Title}"/>
                            <TextBlock Text="Big, hammerhead, medium, small" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="SharkSlider" Style="{StaticResource RowSlider}" Minimum="0" Maximum="4" TickFrequency="1" ValueChanged="Changed"/>
                            <TextBlock x:Name="SharkText" Style="{StaticResource Value}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="18,0"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Manta ray and jellyfish" Style="{StaticResource Title}"/>
                            <TextBlock Text="A slow glider and two drifters" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ExtrasBox" Grid.Column="1" Checked="Changed" Unchecked="Changed" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,-8,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="18,0"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ctl"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ripples on mouse click" Style="{StaticResource Title}"/>
                            <TextBlock Text="A click sends a ripple that pushes nearby fish away" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ClickBox" Grid.Column="1" Checked="Changed" Unchecked="Changed" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,-8,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Text="Startup" Style="{StaticResource Heading}"/>
            <Border Style="{StaticResource Card}">
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Open as a desktop overlay" Style="{StaticResource Title}"/>
                        <TextBlock Text="Click-through, over your windows. Ctrl+Alt+O toggles it any time." Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <CheckBox x:Name="OverlayBox" Grid.Column="1" Checked="Changed" Unchecked="Changed" VerticalAlignment="Center" Margin="12,0,-8,0"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Run as live wallpaper" Style="{StaticResource Title}"/>
                            <TextBlock Text="Behind your desktop icons, on every monitor. Ctrl+Alt+W toggles it any time." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="WallpaperBox" Grid.Column="1" Checked="Changed" Unchecked="Changed" VerticalAlignment="Center" Margin="12,0,-8,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="18,0"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource Title}"/>
                            <TextBlock Text="Launches when you sign in. Off unless you turn it on." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutostartBox" Grid.Column="1" Checked="Autostart_Changed" Unchecked="Autostart_Changed" VerticalAlignment="Center" Margin="12,0,-8,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="ResetButton" Content="Reset to defaults" Padding="16,6" Margin="0,0,8,0" Click="Reset_Click"/>
                <Button x:Name="DoneButton" Content="Done" Padding="30,6" Style="{DynamicResource AccentButtonStyle}" Click="Done_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>

